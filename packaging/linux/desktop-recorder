#!/bin/sh
# Run Desktop Recorder from this folder. No install and no root.
# --install-menu adds Desktop Recorder to the app menu of this user.
set -eu
here=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
export DESKTOP_RECORDER_COMMAND="$here/desktop-recorder"
export PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}"

if [ "${1:-}" = "--install-menu" ]; then
  apps="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
  mkdir -p "$apps"
  cat > "$apps/desktop-recorder.desktop" << EOF
[Desktop Entry]
Type=Application
Name=Desktop Recorder
Comment=Record a region of the screen to MP4
Exec="$here/desktop-recorder"
Icon=$here/desktop-recorder.png
Terminal=false
Categories=AudioVideo;Recorder;
StartupNotify=false
EOF
  echo "Added $apps/desktop-recorder.desktop"
  exit 0
fi

if [ "$#" -eq 0 ] && ! python3 -c 'import gi, Xlib, cairo' >/dev/null 2>&1; then
  echo "Desktop Recorder needs system packages. On Ubuntu 24.04:" >&2
  echo "  sudo apt install ffmpeg python3 python3-gi python3-gi-cairo python3-xlib gir1.2-gtk-3.0 gir1.2-ayatanaappindicator3-0.1 gir1.2-notify-0.7 gir1.2-gstreamer-1.0 gstreamer1.0-plugins-base gstreamer1.0-pipewire pipewire pipewire-pulse wireplumber pulseaudio-utils xdg-desktop-portal xdg-desktop-portal-gnome xclip wl-clipboard" >&2
  exit 1
fi

exec python3 -m desktop_recorder "$@"
